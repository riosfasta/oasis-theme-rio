{%- comment -%}
  THE OASIS — category tabs from plain text

  The menu-driven tab list needs a navigation menu and, for filtering, tagged
  products. On a page template neither is available, so this variant takes a
  typed list instead — one tab per line, "Label | /url".

  A line with no URL renders as plain text rather than a dead link, so the row
  can be filled in with labels now and pointed somewhere later. If no tab
  matches the current URL, the first one is shown as active, which is what the
  design shows on the unfiltered page.

  Accepts:
    - links: {String} one per line, "Label | /url" (url optional)
    - aria_label: {String}
{%- endcomment -%}

{%- if links != blank -%}
  {%- liquid
    assign rows = links | newline_to_br | split: '<br />'

    # Work out the active tab first, so "no match" can fall back to the first.
    assign active_index = 0
    for row in rows
      assign parts = row | split: '|'
      assign row_label = parts[0] | strip
      assign row_href = parts[1] | strip
      if row_label != blank and row_href != blank
        assign row_path = row_href | split: '?' | first
        if row_path == request.path
          assign active_index = forloop.index
        endif
      endif
    endfor
    if active_index == 0
      assign active_index = 1
    endif
  -%}

  <nav class="oasis-tabs__nav" aria-label="{{ aria_label | default: 'Product categories' | escape }}">
    <ul class="oasis-tabs__list">
      {%- for row in rows -%}
        {%- liquid
          assign parts = row | split: '|'
          assign row_label = parts[0] | strip
          assign row_href = parts[1] | strip
          assign is_active = false
          if forloop.index == active_index
            assign is_active = true
          endif
        -%}
        {%- if row_label != blank -%}
          <li class="oasis-tabs__item">
            {%- if row_href != blank -%}
              <a
                class="oasis-tabs__link{% if is_active %} oasis-tabs__link--active{% endif %}"
                href="{{ row_href | escape }}"
                {% if is_active %}
                  aria-current="page"
                {% endif %}
              >
                {{- row_label | escape -}}
              </a>
            {%- else -%}
              <span class="oasis-tabs__link{% if is_active %} oasis-tabs__link--active{% endif %}">
                {{- row_label | escape -}}
              </span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}
