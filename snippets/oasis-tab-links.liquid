{%- comment -%}
  THE OASIS — category tabs from plain text

  The menu-driven tab list needs a navigation menu and, for filtering, tagged
  products. On a page template neither is available, so this variant takes a
  typed list instead — one tab per line, "Label | /url".

  A line with no URL renders as plain text rather than a dead link, so the row
  can be filled in with labels now and pointed somewhere later. If no tab
  matches the current URL, the first one is shown as active, which is what the
  design shows on the unfiltered page.

  FILTER MODE (filter_tags: true, collection routes only)
  Each tab becomes a product-tag filter on the collection it already sits in,
  rather than a link somewhere else. The first row is always the "show
  everything" tab; every row after it filters by the tag after the pipe, or by
  its own label when nothing follows the pipe. The row is wrapped in
  <oasis-tab-filter>, which swaps the grid in place instead of loading a page.

  The links stay real hrefs so that a middle-click still opens the filtered
  collection in a new tab, and so the row works with JavaScript off.

  Accepts:
    - links: {String} one per line, "Label | /url" (url optional)
    - aria_label: {String}
    - filter_tags: {Boolean} turn on filter mode
    - results: {Object} the collection, for reading which tag is active
    - results_url: {String} the collection's own URL, for the "all" tab
{%- endcomment -%}

{%- if links != blank -%}
  {%- liquid
    assign rows = links | newline_to_br | split: '<br />'

    comment
      Which tag is filtering right now. Shopify only populates a tag filter when
      one is configured in Search & Discovery, so this stays empty — and every
      tab stays inactive but the first — until that filter exists.
    endcomment
    assign active_tag = ''
    if filter_tags and results != blank
      for oasis_filter in results.filters
        if oasis_filter.param_name == 'filter.p.tag'
          for oasis_value in oasis_filter.active_values
            assign active_tag = oasis_value.value
          endfor
        endif
      endfor
    endif

    comment
      Link mode only: work out the active tab first, so "no match" can fall back
      to the first.
    endcomment
    assign active_index = 0
    for row in rows
      assign parts = row | split: '|'
      assign row_label = parts[0] | strip
      assign row_href = parts[1] | strip
      if row_label != blank and row_href != blank
        assign row_path = row_href | split: '?' | first
        if row_path == request.path
          assign active_index = forloop.index
        endif
      endif
    endfor
    if active_index == 0
      assign active_index = 1
    endif
  -%}

  {%- comment -%}
    Build the items first and emit nothing at all if none survive, so a setting
    that is nil or holds only separators can't leave an empty <nav> behind.
  {%- endcomment -%}
  {%- capture tab_items -%}
      {%- for row in rows -%}
        {%- liquid
          assign parts = row | split: '|'
          assign row_label = parts[0] | strip
          assign row_value = parts[1] | strip

          if filter_tags
            comment
              The first row clears the filter; the rest carry a tag. An empty
              value means the tag is spelled exactly like the label, which is
              how these read in the design.
            endcomment
            if forloop.first
              assign row_tag = ''
              assign row_href = results_url
            else
              assign row_tag = row_value | default: row_label
              assign row_tag_param = row_tag | url_encode
              assign row_href = results_url | append: '?filter.p.tag=' | append: row_tag_param
            endif
            assign is_active = false
            if row_tag == active_tag
              assign is_active = true
            endif
          else
            assign row_tag = ''
            assign row_href = row_value
            assign is_active = false
            if forloop.index == active_index
              assign is_active = true
            endif
          endif
        -%}
        {%- if row_label != blank -%}
          <li class="oasis-tabs__item">
            {%- if row_href != blank -%}
              <a
                class="oasis-tabs__link{% if is_active %} oasis-tabs__link--active{% endif %}"
                href="{{ row_href | escape }}"
                {% if filter_tags %}
                  data-oasis-tag="{{ row_tag | escape }}"
                {% endif %}
                {% if is_active %}
                  aria-current="page"
                {% endif %}
              >
                {{- row_label | escape -}}
              </a>
            {%- else -%}
              <span class="oasis-tabs__link{% if is_active %} oasis-tabs__link--active{% endif %}">
                {{- row_label | escape -}}
              </span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
  {%- endcapture -%}

  {%- if tab_items != blank -%}
    {%- if filter_tags -%}<oasis-tab-filter>{%- endif -%}
      <nav class="oasis-tabs__nav" aria-label="{{ aria_label | default: 'Product categories' | escape }}">
        <ul class="oasis-tabs__list">{{ tab_items }}</ul>
      </nav>
    {%- if filter_tags -%}</oasis-tab-filter>{%- endif -%}
  {%- endif -%}
{%- endif -%}
