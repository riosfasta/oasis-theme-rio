{%- comment -%}
  THE OASIS — product card
  Hovering (or focusing) a variant thumbnail swaps the card's main image to that
  variant. Behaviour lives in assets/oasis-card.js.

  Accepts:
    - card_product: {Object} product
    - show_swatches: {Boolean} render variant image thumbnails under the price
    - image_ratio: {String} css aspect-ratio value, e.g. "1 / 1"
    - swatch_limit: {Number} how many thumbnails to show (default 6)
    - media_width: {Number} percentage of the column the product box fills
    - media_inset: {Number} percentage of the box kept clear around the product,
      so a greeting card renders smaller than a journal in the same box
    - media_background: {String} css colour behind the product, or 'none'
    - lazy_load: {Boolean} pass false for cards above the fold so the first row
      is not deferred (Dawn computes this per card; ignoring it costs LCP)
    - show_secondary_image: {Boolean} cross-fade to the product's second media
      on hover. It is stacked, not swapped, so the fade is smooth and the
      variant-thumbnail swap below keeps working: a hovered or selected swatch
      hides the secondary image so its own image is the one you see.
{%- endcomment -%}

{%- liquid
  assign ratio = image_ratio | default: '1 / 1'
  assign max_swatches = swatch_limit | default: 6
  assign box_width = media_width | default: 100
  assign inset = media_inset | default: 0
  assign media_bg = media_background | default: 'none'

  assign img_loading = 'lazy'
  if lazy_load == false
    assign img_loading = 'eager'
  endif
-%}

{%- capture card_vars -%}
  --oasis-card-ratio: {{ ratio }}; --oasis-card-media-width: {{ box_width }}%; --oasis-card-inset: {{ inset }}%; --oasis-card-media-bg: {{ media_bg }};
{%- endcapture -%}

{%- if card_product and card_product != empty -%}
  <oasis-card class="oasis-card" style="{{ card_vars | strip_newlines | strip }}">
    <a class="oasis-card__media" href="{{ card_product.url }}">
      {%- if card_product.featured_media -%}
        {{
          card_product.featured_media
          | image_url: width: 800
          | image_tag:
            widths: '200, 300, 400, 600, 800',
            sizes: '(min-width: 990px) 300px, 45vw',
            loading: img_loading,
            class: 'oasis-card__image',
            data-main-image: '',
            alt: card_product.featured_media.alt
        }}

        {%- if show_secondary_image and card_product.media.size > 1 -%}
          {%- comment -%}
            media[1] rather than images[1] so it follows the order the merchant
            set in the admin. Always lazy: it is never the LCP image.
          {%- endcomment -%}
          {{
            card_product.media[1]
            | image_url: width: 800
            | image_tag:
              widths: '200, 300, 400, 600, 800',
              sizes: '(min-width: 990px) 300px, 45vw',
              loading: 'lazy',
              class: 'oasis-card__image oasis-card__image--secondary',
              aria-hidden: 'true',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    <a class="oasis-card__title" href="{{ card_product.url }}">{{ card_product.title | escape }}</a>

    <p class="oasis-card__price">
      {%- if card_product.compare_at_price > card_product.price -%}
        <s>{{ card_product.compare_at_price | money }}</s>
      {%- endif -%}
      {{ card_product.price | money }}
    </p>

    {%- if show_swatches and card_product.variants.size > 1 -%}
      {%- liquid
        comment
          Two passes, because the row has to keep its width: when there are more
          variant images than fit, the last slot becomes a "+N" chip instead of a
          thumbnail, and that decision needs the total before rendering starts.

          Keys are wrapped in commas on BOTH sides. With a trailing comma only,
          a seen list of "1234," would match the key "234," and silently drop a
          real variant.
        endcomment
        assign seen_total = ','
        assign swatch_total = 0
        for variant in card_product.variants
          if variant.image != blank
            assign media_key = variant.image.id | prepend: ',' | append: ','
            unless seen_total contains media_key
              assign seen_total = seen_total | append: variant.image.id | append: ','
              assign swatch_total = swatch_total | plus: 1
            endunless
          endif
        endfor

        assign swatch_show = max_swatches
        assign swatch_more = 0
        if swatch_total > max_swatches
          assign swatch_show = max_swatches | minus: 1
          if swatch_show < 1
            assign swatch_show = 1
          endif
          assign swatch_more = swatch_total | minus: swatch_show
        endif

        assign seen_media = ','
        assign swatch_count = 0
      -%}
      {%- capture swatch_markup -%}
        {%- for variant in card_product.variants -%}
          {%- if variant.image != blank and swatch_count < swatch_show -%}
            {%- assign media_key = variant.image.id | prepend: ',' | append: ',' -%}
            {%- unless seen_media contains media_key -%}
              {%- liquid
                assign seen_media = seen_media | append: variant.image.id | append: ','
                assign swatch_count = swatch_count | plus: 1
              -%}
              {%- capture v_srcset -%}
                {{ variant.image | image_url: width: 200 }} 200w,
                {{ variant.image | image_url: width: 300 }} 300w,
                {{ variant.image | image_url: width: 400 }} 400w,
                {{ variant.image | image_url: width: 600 }} 600w,
                {{ variant.image | image_url: width: 800 }} 800w
              {%- endcapture -%}
              <a
                class="oasis-card__swatch"
                href="{{ variant.url }}"
                aria-label="{{ variant.title | escape }}"
                data-variant-src="{{ variant.image | image_url: width: 800 }}"
                data-variant-srcset="{{ v_srcset | strip_newlines | strip }}"
              >
                {{
                  variant.image
                  | image_url: width: 120
                  | image_tag: widths: '40, 80, 120', loading: 'lazy', alt: variant.title | escape
                }}
              </a>
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if swatch_total > 1 -%}
        <div class="oasis-card__swatches">
          {{ swatch_markup }}
          {%- if swatch_more > 0 -%}
            {%- comment -%}
              Deliberately not a slider or an expander: this is a grid card, and
              a second scrollable thing inside it competes with the card's own
              link. The chip says how many are left and goes to the product,
              where every variant is shown. It carries no data-variant-src, so
              oasis-card.js ignores it and it never swaps the card image.
            {%- endcomment -%}
            <a
              class="oasis-card__swatch oasis-card__swatch--more"
              href="{{ card_product.url }}"
              aria-label="See all {{ swatch_total }} options of {{ card_product.title | escape }}"
            >
              <span aria-hidden="true">+{{ swatch_more }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </oasis-card>
{%- else -%}
  <div class="oasis-card" style="{{ card_vars | strip_newlines | strip }}">
    <span class="oasis-card__media">
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </span>
    <span class="oasis-card__title">{{ 'onboarding.product_title' | t }}</span>
    <p class="oasis-card__price">{{ 2000 | money }}</p>
  </div>
{%- endif -%}
