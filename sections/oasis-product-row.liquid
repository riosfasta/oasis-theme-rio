{%- comment -%}
  THE OASIS — product row
  Centred heading + "VIEW ALL →" link + a row of product cards on white tiles.
  Used for New Arrivals and Best Sellers.
{%- endcomment -%}

{%- liquid
  assign products_to_show = section.settings.products_to_show
  assign target = section.settings.collection
-%}

<div
  class="oasis-row"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="oasis-container">
    <div class="oasis-row__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="oasis-section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all -%}
        <a class="oasis-section-link" href="{{ target.url | default: routes.all_products_collection_url }}">
          {{- section.settings.view_all_label | escape }} &rarr;
        </a>
      {%- endif -%}
    </div>

    {%- comment -%}
      The cards are identical either way, so capture them once and choose the
      wrapper: a CSS grid, or a scroll-snap track with arrows. The track uses
      native overflow scrolling rather than transforms, so touch swipe, keyboard
      and reduced-motion all come for free.
    {%- endcomment -%}
    {%- capture row_cards -%}
      {%- if target != blank and target.products_count > 0 -%}
        {%- for product in target.products limit: products_to_show -%}
          {%- render 'oasis-product-card',
            show_secondary_image: section.settings.oasis_secondary_image,
            card_product: product,
            show_swatches: section.settings.show_swatches,
            swatch_limit: section.settings.swatch_limit,
            image_ratio: section.settings.image_ratio,
            media_width: section.settings.oasis_media_width,
            media_inset: section.settings.oasis_media_inset,
            media_background: section.settings.oasis_media_background
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          {%- render 'oasis-product-card',
            show_secondary_image: section.settings.oasis_secondary_image,
            card_product: null,
            image_ratio: section.settings.image_ratio,
            media_width: section.settings.oasis_media_width,
            media_inset: section.settings.oasis_media_inset,
            media_background: section.settings.oasis_media_background
          -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if section.settings.enable_slider -%}
      <oasis-row-slider class="oasis-row__slider">
        <button
          class="oasis-row__arrow oasis-row__arrow--prev"
          type="button"
          data-prev
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="oasis-products oasis-products--slider" data-track>
          {{ row_cards }}
        </div>

        <button
          class="oasis-row__arrow oasis-row__arrow--next"
          type="button"
          data-next
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </oasis-row-slider>
    {%- else -%}
      <div
        class="oasis-products"
        style="grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));"
      >
        {{ row_cards }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div style="text-align:center; margin-top: 4.4rem;">
        <a class="oasis-btn oasis-btn--dark" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .oasis-products {
    gap: {{ section.settings.grid_gap }}px;
    --oasis-gap: {{ section.settings.grid_gap }}px;
    --oasis-per-view: {{ section.settings.columns_desktop }};
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .oasis-products {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr)) !important;
      --oasis-per-view: {{ section.settings.columns_mobile }};
    }
  }
</style>

{% schema %}
{
  "name": "Oasis product row",
  "class": "oasis-section-row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Slide instead of wrap",
      "info": "Shows \"Columns on desktop\" products at a time with arrows to page through the rest. Without it, all products wrap onto multiple rows.",
      "default": false
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between cards",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall portrait" },
        { "value": "2 / 3", "label": "Extra tall portrait" }
      ],
      "default": "2 / 3"
    },
    {
      "type": "range",
      "id": "oasis_media_width",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Product size in the grid",
      "info": "How much of each column the product fills. The PSD uses 76% for journals and 53% for the smaller greeting cards.",
      "default": 76
    },
    {
      "type": "range",
      "id": "oasis_media_inset",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "label": "Space around the product",
      "info": "Renders the product smaller inside the same box. The PSD uses 0 for journals and 15% for the physically smaller greeting cards.",
      "default": 0
    },
    {
      "type": "select",
      "id": "oasis_media_background",
      "label": "Tile behind the product",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "#ffffff", "label": "White" },
        { "value": "var(--oasis-blush)", "label": "Blush" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "oasis_secondary_image",
      "label": "Show second image on hover",
      "info": "Cross-fades to the product's second image. Products with only one image are unaffected.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show variant thumbnails",
      "info": "Hovering a thumbnail swaps the card's main image to that variant.",
      "default": true
    },
    {
      "type": "range",
      "id": "swatch_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum thumbnails per card",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Button below the row"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Oasis product row"
    }
  ]
}
{% endschema %}
