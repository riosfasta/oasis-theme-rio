{%- comment -%}
  THE OASIS — hero slider
  Full-bleed image slides with a soft cream scrim and left/right/centre copy.
  Every slide is a block, so slides can be added, reordered or removed in the editor.
{%- endcomment -%}

<div
  class="oasis-hero"
  id="OasisHero-{{ section.id }}"
  style="--oasis-hero-height: {{ section.settings.height }}px;"
>
  <oasis-hero-slider
    class="oasis-hero__viewport"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  >
    <div class="oasis-hero__track" data-track>
      {%- for block in section.blocks -%}
        <div
          class="oasis-hero__slide oasis-hero__slide--{{ block.settings.content_position }}"
          data-slide
          {{ block.shopify_attributes }}
        >
          {%- liquid
            if forloop.first
              assign img_loading = 'eager'
              assign img_priority = 'high'
            else
              assign img_loading = 'lazy'
              assign img_priority = 'auto'
            endif
          -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 2880
              | image_tag:
                class: 'oasis-hero__bg',
                widths: '750, 1100, 1440, 1900, 2880',
                sizes: '100vw',
                loading: img_loading,
                fetchpriority: img_priority,
                alt: block.settings.image.alt
            }}
          {%- else -%}
            <img
              class="oasis-hero__bg"
              src="{{ 'oasis-hero-slide-1.jpg' | asset_url }}"
              alt="{{ block.settings.heading | escape }}"
              width="1440"
              height="675"
              {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
            >
          {%- endif -%}

          <div class="oasis-hero__scrim" aria-hidden="true"></div>

          <div class="oasis-hero__inner">
            <div class="oasis-hero__content">
              {%- if block.settings.heading != blank -%}
                <h2 class="oasis-hero__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="oasis-hero__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                <div class="oasis-hero__buttons">
                  {%- if block.settings.button_label_1 != blank -%}
                    <a
                      class="oasis-btn oasis-btn--dark"
                      href="{{ block.settings.button_link_1 | default: '#' }}"
                    >
                      {{- block.settings.button_label_1 | escape -}}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a
                      class="oasis-btn oasis-btn--light"
                      href="{{ block.settings.button_link_2 | default: '#' }}"
                    >
                      {{- block.settings.button_label_2 | escape -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      {%- if section.settings.show_arrows -%}
        <button class="oasis-hero__arrow oasis-hero__arrow--prev" type="button" data-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
        <button class="oasis-hero__arrow oasis-hero__arrow--next" type="button" data-next aria-label="{{ 'general.slider.next_slide' | t }}">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
      {%- endif -%}
      {%- if section.settings.show_dots -%}
        <div class="oasis-hero__dots" data-dots>
          {%- for block in section.blocks -%}
            <button
              class="oasis-hero__dot"
              type="button"
              data-index="{{ forloop.index0 }}"
              aria-label="{{ 'general.slider.name' | t }} {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </oasis-hero-slider>
</div>

<style>
  #OasisHero-{{ section.id }} .oasis-hero__slide { min-height: {{ section.settings.height }}px; }
  #OasisHero-{{ section.id }} .oasis-hero__arrow--prev svg { transform: rotate(90deg); }
  #OasisHero-{{ section.id }} .oasis-hero__arrow--next svg { transform: rotate(-90deg); }
  @media screen and (max-width: 989px) {
    #OasisHero-{{ section.id }} .oasis-hero__slide { min-height: 0; }
    #OasisHero-{{ section.id }} .oasis-hero__bg { height: {{ section.settings.height | times: 0.5 | round }}px; }
  }
</style>

<script>
  if (!customElements.get('oasis-hero-slider')) {
    customElements.define(
      'oasis-hero-slider',
      class OasisHeroSlider extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-track]');
          this.slides = Array.from(this.querySelectorAll('[data-slide]'));
          this.dots = Array.from(this.querySelectorAll('[data-dots] button'));
          this.index = 0;
          if (this.slides.length < 2) return;

          const prev = this.querySelector('[data-prev]');
          const next = this.querySelector('[data-next]');
          if (prev) prev.addEventListener('click', () => this.go(this.index - 1, true));
          if (next) next.addEventListener('click', () => this.go(this.index + 1, true));
          this.dots.forEach((dot) =>
            dot.addEventListener('click', () => this.go(parseInt(dot.dataset.index, 10), true))
          );

          this.addEventListener('mouseenter', () => this.stop());
          this.addEventListener('mouseleave', () => this.start());
          this.addEventListener('focusin', () => this.stop());

          let startX = null;
          this.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
          this.addEventListener(
            'touchend',
            (e) => {
              if (startX === null) return;
              const dx = e.changedTouches[0].clientX - startX;
              if (Math.abs(dx) > 45) this.go(this.index + (dx < 0 ? 1 : -1), true);
              startX = null;
            },
            { passive: true }
          );

          this.start();
        }

        disconnectedCallback() {
          this.stop();
        }

        go(i, userInitiated) {
          const total = this.slides.length;
          this.index = (i + total) % total;
          this.track.style.transform = `translateX(-${this.index * 100}%)`;
          this.dots.forEach((dot, n) => {
            if (n === this.index) {
              dot.setAttribute('aria-current', 'true');
            } else {
              dot.removeAttribute('aria-current');
            }
          });
          if (userInitiated) this.restart();
        }

        start() {
          if (this.dataset.autoplay !== 'true' || this.slides.length < 2) return;
          const speed = parseInt(this.dataset.speed, 10) || 6000;
          this.timer = setInterval(() => this.go(this.index + 1), speed);
        }

        stop() {
          clearInterval(this.timer);
        }

        restart() {
          this.stop();
          this.start();
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Oasis hero slider",
  "class": "oasis-section-hero",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "height",
      "min": 400,
      "max": 900,
      "step": 5,
      "unit": "px",
      "label": "Desktop height",
      "default": 675
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended 2880 × 1540px. Leave empty to use the packaged design image."
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Text position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Every story finds hope."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Behind every beautiful product is a story of courage and resilience.</p><p>Your purchase helps carry her story forward.</p>"
        },
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Primary button label",
          "default": "Shop journals"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary button label",
          "default": "Shop cards"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oasis hero slider",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
