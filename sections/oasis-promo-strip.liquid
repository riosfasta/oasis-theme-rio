{%- comment -%}
  THE OASIS — promo strip
  Full-bleed tan band with one bold line, sitting under a page banner.
{%- endcomment -%}

<div class="oasis-promo" id="OasisPromo-{{ section.id }}">
  {%- if section.settings.link != blank -%}
    <a class="oasis-promo__text" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
  {%- else -%}
    <p class="oasis-promo__text">{{ section.settings.text | escape }}</p>
  {%- endif -%}
</div>

<style>
  #OasisPromo-{{ section.id }} {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    min-height: {{ section.settings.height }}px;
  }
</style>

{% schema %}
{
  "name": "Oasis promo strip",
  "class": "oasis-section-promo",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Choose any 5 hand-stitched cards for $20."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#A2846F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "height",
      "min": 40,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Height",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Oasis promo strip"
    }
  ]
}
{% endschema %}
