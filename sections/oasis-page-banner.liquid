{%- comment -%}
  THE OASIS — page banner
  Condensed title, floral divider, intro line, over a soft full-bleed photo.
  Used by the Shop pages, Bulk Ordering and Contact Us.
  On a collection page it falls back to the collection's own title / description /
  image, so one template can serve Shop All, Journals and Cards.
{%- endcomment -%}

{%- liquid
  assign b_title = section.settings.title
  assign b_text = section.settings.text
  assign b_image = section.settings.image

  if section.settings.use_collection and collection != blank
    if b_title == blank
      assign b_title = collection.title
    endif
    if b_text == blank
      assign b_text = collection.description
    endif
    if b_image == blank and section.settings.fallback_asset == blank
      assign b_image = collection.image
    endif
  endif

  if section.settings.use_page and page != blank and b_title == blank
    assign b_title = page.title
  endif

  comment
    Each ornament is a different shape and the CSS sets height:auto, so the
    width/height attributes have to be that file's own intrinsic size — not the
    278px it displays at — or the banner jumps as the image loads. Keep this
    case in step with the files in assets/.
  endcomment
  assign ornament = section.settings.ornament_asset | default: 'oasis-ornament-divider-banner.png'
  case ornament
    when 'oasis-ornament-divider-journals.png'
      assign ornament_w = 1112
      assign ornament_h = 150
    else
      assign ornament_w = 1112
      assign ornament_h = 162
  endcase
-%}

<div class="oasis-banner oasis-banner--{{ section.settings.content_position }}" id="OasisBanner-{{ section.id }}">
  {%- comment -%}
    Wrapped so a phone-specific file can replace it below 990px. See the snippet.
  {%- endcomment -%}
  {%- capture oasis_bg_desktop -%}
  {%- if b_image != blank -%}
      {{
        b_image
        | image_url: width: 2880
        | image_tag:
          class: 'oasis-banner__bg',
          widths: '750, 1100, 1440, 1900, 2880',
          sizes: '100vw',
          fetchpriority: 'high',
          alt: b_image.alt
      }}
    {%- elsif section.settings.fallback_asset != blank -%}
      <img
        class="oasis-banner__bg"
        src="{{ section.settings.fallback_asset | asset_url }}"
        alt=""
        width="1440"
        height="363"
        fetchpriority="high"
      >
    {%- endif -%}
  {%- endcapture -%}
  {%- render 'oasis-bg-picture', image_mobile: section.settings.image_mobile, desktop: oasis_bg_desktop -%}

  <div class="oasis-banner__scrim" aria-hidden="true"></div>

  <div class="oasis-banner__inner">
    <div class="oasis-banner__content">
      {%- if b_title != blank -%}
        <h1 class="oasis-banner__title">{{ b_title }}</h1>
      {%- endif -%}

      {%- if section.settings.show_ornament -%}
        <img
          class="oasis-banner__ornament"
          src="{{ ornament | asset_url }}"
          alt=""
          width="{{ ornament_w }}"
          height="{{ ornament_h }}"
          loading="lazy"
        >
      {%- endif -%}

      {%- if b_text != blank -%}
        <div class="oasis-banner__text rte">{{ b_text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- liquid
  comment
    Which part of the photograph to keep when it is cropped on a phone. These
    banner photographs are composed with everything on the side the text column
    does not cover, so "auto" means the opposite side from the text. Measured on
    the bulk-ordering banner: the left two thirds carry no detail at all (edge
    energy 0.0 and 1.3) against 11.8 in the right third, where the subject is,
    and the text sits left.

    A centred banner has nothing to sit opposite, so it keeps the middle.
  endcomment
  assign banner_focus = section.settings.image_focus_mobile | default: 'auto'
  if banner_focus == 'auto'
    case section.settings.content_position
      when 'right'
        assign banner_focus = 'left'
      when 'center'
        assign banner_focus = 'center'
      else
        assign banner_focus = 'right'
    endcase
  endif
-%}

{%- liquid
  comment
    A phone photograph is the one the band actually shows below 990px, so its
    proportions are the ones to size the band by. Giving the band that shape
    means the uploaded file is shown whole, which is the point of uploading one
    cut for phones in the first place. Without one, the fixed height stands.
  endcomment
  assign banner_ratio = ''
  if section.settings.image_mobile != blank
    assign banner_ratio = section.settings.image_mobile.aspect_ratio
  endif
-%}

<style>
  #OasisBanner-{{ section.id }} { min-height: {{ section.settings.height }}px; }
  #OasisBanner-{{ section.id }} .oasis-banner__content { max-width: {{ section.settings.content_width }}px; }
  #OasisBanner-{{ section.id }} .oasis-banner__scrim {
    background: linear-gradient({% if section.settings.content_position == 'right' %}270deg{% else %}90deg{% endif %},
      {{ section.settings.scrim_color }} 0%,
      {{ section.settings.scrim_color | color_modify: 'alpha', 0.7 }} 38%,
      {{ section.settings.scrim_color | color_modify: 'alpha', 0 }} 62%);
  }
  {%- if section.settings.content_position == 'center' -%}
  #OasisBanner-{{ section.id }} .oasis-banner__scrim { background: {{ section.settings.scrim_color | color_modify: 'alpha', 0.5 }}; }
  {%- endif -%}
  @media screen and (max-width: 989px) {
    #OasisBanner-{{ section.id }} { min-height: 0; }
    #OasisBanner-{{ section.id }} .oasis-banner__scrim { background: none; }
    /*
      Stacked layout, so the photograph is a band of its own.

      On desktop it is an oversized backdrop — 130vw wide, pulled 30vw to the
      left — so that it bleeds well past the text column. Those two values have
      to be undone here or they carry into the phone, where 130vw is 489px and
      -30vw is -113px: the photo starts off the left edge and stops 57px short
      of the right one, leaving a bare strip of the banner's own sand colour.
      Cropping to the phone's width instead, focused away from the text, fills
      the band and keeps the subject.
    */
    #OasisBanner-{{ section.id }}.oasis-banner .oasis-banner__bg {
      position: relative;
      inset: auto;
      width: 100%;
      {%- if banner_ratio != blank %}
      height: auto;
      aspect-ratio: {{ banner_ratio }};
      {%- else %}
      height: {{ section.settings.height_mobile }}px;
      {%- endif %}
      object-fit: cover;
      object-position: {{ banner_focus }} center;
    }
  }
</style>

{% schema %}
{
  "name": "Oasis page banner",
  "class": "oasis-section-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended 2880 × 726px."
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Packaged design image",
      "info": "Theme asset filename used when no image is chosen, e.g. oasis-banner-journals.jpg"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "height",
      "min": 240,
      "max": 640,
      "step": 5,
      "unit": "px",
      "label": "Desktop height",
      "default": 365
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 780,
      "step": 10,
      "unit": "px",
      "label": "Text column width",
      "default": 600
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Overlay colour",
      "default": "#F1E4D4"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Photo",
      "info": "Optional. Shown instead of the main photo on phones, and only downloaded there. The band takes this photo's own shape, so nothing is cropped \u2014 upload a squarer or upright version of the same scene."
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 140,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Photo height",
      "info": "A shorter band shows more of the photo's width, because the crop fills the height first.",
      "default": 220
    },
    {
      "type": "select",
      "id": "image_focus_mobile",
      "label": "Photo focus",
      "info": "Which part of the photo to keep when it is cropped. Automatic uses the side opposite the text, where these photos put their subject.",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "use_collection",
      "label": "Use the collection's title, text and image",
      "info": "On collection pages. Anything you type below overrides it.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "use_page",
      "label": "Use the page title",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "checkbox",
      "id": "show_ornament",
      "label": "Show floral divider",
      "default": true
    },
    {
      "type": "select",
      "id": "ornament_asset",
      "label": "Which divider",
      "options": [
        { "value": "oasis-ornament-divider-banner.png", "label": "Branch" },
        { "value": "oasis-ornament-divider-journals.png", "label": "Leafy vine" }
      ],
      "default": "oasis-ornament-divider-banner.png"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Oasis page banner"
    }
  ]
}
{% endschema %}
