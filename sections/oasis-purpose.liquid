{%- comment -%}
  THE OASIS — "Shop with purpose" band
  Full-bleed portrait on one side, and on the other: leaf ornament, tracked-out
  heading, condensed tagline, an "EVERY PURCHASE =" icon equation, text and a button.
{%- endcomment -%}

<div class="oasis-purpose" id="OasisPurpose-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2880
      | image_tag:
        class: 'oasis-purpose__bg',
        widths: '750, 1100, 1440, 1900, 2880',
        sizes: '100vw',
        loading: 'lazy',
        alt: section.settings.image.alt
    }}
  {%- else -%}
    <img
      class="oasis-purpose__bg"
      src="{{ 'oasis-purpose-bg.jpg' | asset_url }}"
      alt=""
      width="1398"
      height="846"
      loading="lazy"
    >
  {%- endif -%}

  <div class="oasis-purpose__scrim" aria-hidden="true"></div>

  <div class="oasis-purpose__inner">
    <div class="oasis-purpose__content">
      {%- if section.settings.show_leaf -%}
        <img
          class="oasis-leaf"
          src="{{ 'oasis-ornament-leaf.png' | asset_url }}"
          alt=""
          width="107"
          height="71"
          loading="lazy"
        >
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="oasis-purpose__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.show_rule -%}
        <hr class="oasis-rule oasis-rule--center" style="margin: 1.8rem auto;">
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="oasis-purpose__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- if section.settings.equation_label != blank -%}
          <p class="oasis-purpose__eyebrow">{{ section.settings.equation_label | escape }}</p>
        {%- endif -%}
        <div class="oasis-purpose__icons">
          {%- for block in section.blocks -%}
            {%- unless forloop.first -%}
              <span class="oasis-purpose__plus" aria-hidden="true">+</span>
            {%- endunless -%}
            {%- assign fallback_index = forloop.index | at_most: 5 -%}
            <div class="oasis-purpose__icon" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 240
                  | image_tag: widths: '108, 216, 240', loading: 'lazy', alt: block.settings.label
                }}
              {%- else -%}
                <img
                  src="{{ 'oasis-purpose-icon-' | append: fallback_index | append: '.png' | asset_url }}"
                  alt=""
                  width="108"
                  height="108"
                  loading="lazy"
                >
              {%- endif -%}
              <span>{{ block.settings.label | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_rule_2 -%}
        <hr class="oasis-rule oasis-rule--center" style="margin: 2.6rem auto;">
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="oasis-purpose__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="oasis-btn oasis-btn--tan"
          href="{{ section.settings.button_link | default: '#' }}"
          style="margin-top: 3.4rem;"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #OasisPurpose-{{ section.id }} { min-height: {{ section.settings.height }}px; }
  #OasisPurpose-{{ section.id }} .oasis-purpose__content { max-width: {{ section.settings.content_width }}px; }
  #OasisPurpose-{{ section.id }} .oasis-purpose__inner {
    justify-content: {% if section.settings.content_position == 'left' %}flex-start{% else %}flex-end{% endif %};
  }
  #OasisPurpose-{{ section.id }} .oasis-purpose__scrim {
    background: linear-gradient({% if section.settings.content_position == 'left' %}90deg{% else %}270deg{% endif %},
      {{ section.settings.scrim_color }} 0%,
      {{ section.settings.scrim_color | color_modify: 'alpha', 0.8 }} 30%,
      {{ section.settings.scrim_color | color_modify: 'alpha', 0 }} 54%);
  }
  @media screen and (max-width: 989px) {
    #OasisPurpose-{{ section.id }} { min-height: 0; }
    #OasisPurpose-{{ section.id }} .oasis-purpose__scrim { background: none; }
    #OasisPurpose-{{ section.id }} .oasis-purpose__inner {
      justify-content: center !important;
      background: {{ section.settings.scrim_color }};
    }
  }
</style>

{% schema %}
{
  "name": "Oasis purpose band",
  "class": "oasis-section-purpose",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended 2880 × 1692px. Leave empty to use the packaged design image."
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Text side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "height",
      "min": 400,
      "max": 900,
      "step": 5,
      "unit": "px",
      "label": "Desktop height",
      "default": 845
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 460,
      "max": 780,
      "step": 10,
      "unit": "px",
      "label": "Text column width",
      "default": 660
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Overlay colour",
      "default": "#FBF7F4"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_leaf",
      "label": "Show leaf ornament",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop with purpose"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show rule under heading",
      "default": true
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline (condensed bold)",
      "default": "Every purchase has a purpose."
    },
    {
      "type": "text",
      "id": "equation_label",
      "label": "Icon row label",
      "default": "Every purchase ="
    },
    {
      "type": "checkbox",
      "id": "show_rule_2",
      "label": "Show rule under icons",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Your purchase helps provide women rebuilding their lives after trafficking with dignified work, skills training, healing, and hope for a new future—<strong>while creating greater opportunities for their children to thrive.</strong></p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more about The Oasis"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon",
          "info": "Leave empty to use the packaged design icon for this position."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Dignified work"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oasis purpose band",
      "blocks": [
        { "type": "icon" },
        { "type": "icon" },
        { "type": "icon" },
        { "type": "icon" },
        { "type": "icon" }
      ]
    }
  ]
}
{% endschema %}
