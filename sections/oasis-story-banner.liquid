{%- comment -%}
  THE OASIS — story banner
  Full-bleed photograph with a soft sand scrim and a condensed kicker + script line.
  Used for "BE A PART OF HER / freedom story".
{%- endcomment -%}

<div
  class="oasis-story oasis-story--{{ section.settings.content_position }} oasis-story--{{ section.settings.kicker_style }}"
  id="OasisStory-{{ section.id }}"
>
  {%- comment -%}
    Wrapped so a phone-specific file can replace it below 990px. See the snippet.
  {%- endcomment -%}
  {%- capture oasis_bg_desktop -%}
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2880
        | image_tag:
          class: 'oasis-story__bg',
          widths: '750, 1100, 1440, 1900, 2880',
          sizes: '100vw',
          loading: 'lazy',
          alt: section.settings.image.alt
      }}
    {%- elsif section.settings.fallback_asset != blank -%}
      <img
        class="oasis-story__bg"
        src="{{ section.settings.fallback_asset | asset_url }}"
        alt="{{ section.settings.kicker | escape }}"
        width="1440"
        height="668"
        loading="lazy"
      >
    {%- endif -%}
  {%- endcapture -%}
  {%- render 'oasis-bg-picture', image_mobile: section.settings.image_mobile, desktop: oasis_bg_desktop -%}

  <div class="oasis-story__scrim" aria-hidden="true"></div>

  <div class="oasis-story__inner">
    <div class="oasis-story__content">
      {%- if section.settings.show_leaf -%}
        <img
          class="oasis-leaf"
          src="{{ 'oasis-ornament-leaf.png' | asset_url }}"
          alt=""
          {%- comment -%}
            The file's own size, not the 107px it displays at: the CSS sets
            height:auto, so these attributes are what reserve the right box while
            it loads. The asset is 4x the display width so it stays sharp on a
            retina screen.
          {%- endcomment -%}
          width="428"
          height="286"
          loading="lazy"
        >
      {%- endif -%}
      {%- if section.settings.kicker != blank -%}
        <h2 class="oasis-story__kicker">{{ section.settings.kicker | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.script != blank -%}
        <p class="oasis-story__script">{{ section.settings.script | escape }}</p>
      {%- endif -%}
      {%- if section.settings.show_rule -%}
        <hr class="oasis-rule">
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="oasis-story__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="oasis-story__button">
          <a class="oasis-btn oasis-btn--tan" href="{{ section.settings.button_link | default: '#' }}">
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- liquid
  comment
    Which part of the photo to keep when it is cropped on a phone. These photos
    are composed with the subject on the side the desktop scrim does NOT cover,
    so "auto" simply means the opposite side from the text — which is right for
    every banner on the site without anyone having to set it.
  endcomment
  assign story_focus = section.settings.image_focus_mobile | default: 'auto'
  if story_focus == 'auto'
    if section.settings.content_position == 'right'
      assign story_focus = 'left'
    else
      assign story_focus = 'right'
    endif
  endif

  comment
    Flex `order` on the two items. The scrim is absolutely positioned, so it is
    not a flex item and is unaffected either way.
  endcomment
  if section.settings.image_order_mobile == 'above'
    assign story_bg_order = 1
    assign story_inner_order = 2
  else
    assign story_bg_order = 2
    assign story_inner_order = 1
  endif

  comment
    How tall the band is on a phone, which is really a question about how much
    of the photo survives. A fixed height crops the sides, and the taller it is
    the more it crops: at 320px the homepage photo shows 66% of its width, at
    240px 88%. Giving the band the photo's own shape instead crops nothing.

    That needs the photo's true proportions, which are only knowable for an
    uploaded image — `aspect_ratio` comes from Shopify. A packaged theme asset
    is rendered with hardcoded width/height attributes that do not always match
    the file, so rather than crop to a number that might be wrong, those banners
    keep the fixed height.

    When a separate phone photo is set it is the one the band actually shows,
    so its proportions are the ones to size the band by — not the desktop
    photo's.
  endcomment
  assign story_ratio = ''
  if section.settings.image_mobile != blank
    assign story_ratio = section.settings.image_mobile.aspect_ratio
  elsif section.settings.image != blank
    assign story_ratio = section.settings.image.aspect_ratio
  endif
  assign story_fit = section.settings.fit_mobile | default: 'whole'
-%}

<style>
  #OasisStory-{{ section.id }} { min-height: {{ section.settings.height }}px; }
  #OasisStory-{{ section.id }} .oasis-story__content { max-width: {{ section.settings.content_width }}px; }
  {%- if section.settings.text_align == 'center' -%}
  #OasisStory-{{ section.id }} .oasis-story__content { text-align: center; }
  #OasisStory-{{ section.id }} .oasis-rule,
  #OasisStory-{{ section.id }} .oasis-leaf { margin-inline: auto; }
  {%- endif -%}
  #OasisStory-{{ section.id }} .oasis-story__scrim {
    background: linear-gradient({% if section.settings.content_position == 'right' %}270deg{% else %}90deg{% endif %},
      {{ section.settings.scrim_color }} 0%,
      {{ section.settings.scrim_color | color_modify: 'alpha', 0.72 }} 34%,
      {{ section.settings.scrim_color | color_modify: 'alpha', 0 }} 58%);
  }
  @media screen and (max-width: 989px) {
    #OasisStory-{{ section.id }} { min-height: 0; }
    #OasisStory-{{ section.id }} .oasis-story__scrim { background: none; }
    #OasisStory-{{ section.id }}.oasis-story .oasis-story__inner {
      background: {{ section.settings.scrim_color }};
      order: {{ story_inner_order }};
    }
    /*
      Stacked layout, so the photo is a band of its own.

      Two things have to be undone here, and the id is doubled up with the
      class deliberately so that both survive.

      `position` — on desktop the photo is an absolutely positioned backdrop.
      Left that way it is out of the flow, so `order` cannot place it and the
      text block, which has an opaque background on mobile, simply paints over
      it. It has to come back into the column as a real flex item.

      `width`/`height` — the desktop rule sizes the photo by its own aspect
      ratio, so at a fixed height it is far wider than a phone and the section
      clips whichever half will not fit. On these photos the subject stands in
      the clipped half. Cropping instead, focused on her side, keeps her.

      The extra class also outranks anything Shopify's per-section Custom CSS
      box emits, which is scoped to `#shopify-section-<id>` — one id and one
      class — and is printed after this block, so at equal weight it would win.
    */
    #OasisStory-{{ section.id }}.oasis-story .oasis-story__bg {
      position: relative;
      inset: auto;
      width: 100%;
      {%- if story_fit == 'whole' and story_ratio != blank %}
      height: auto;
      aspect-ratio: {{ story_ratio }};
      {%- else %}
      height: {{ section.settings.height_mobile }}px;
      {%- endif %}
      object-fit: cover;
      object-position: {{ story_focus }} center;
      order: {{ story_bg_order }};
    }
  }
</style>

{% schema %}
{
  "name": "Oasis story banner",
  "class": "oasis-section-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Recommended 2880 × 1336px. Leave empty to use the packaged design image."
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Packaged design image",
      "info": "Theme asset filename used when no image is chosen, e.g. oasis-story-restore-hope.jpg"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Text side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "kicker_style",
      "label": "Heading style",
      "info": "Condensed bold is the homepage look; tracked light is the wider style used on the inner pages.",
      "options": [
        { "value": "condensed", "label": "Condensed bold" },
        { "value": "tracked", "label": "Tracked light" }
      ],
      "default": "condensed"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "height",
      "min": 400,
      "max": 900,
      "step": 5,
      "unit": "px",
      "label": "Desktop height",
      "default": 670
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 380,
      "max": 780,
      "step": 10,
      "unit": "px",
      "label": "Text column width",
      "default": 560
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Overlay colour",
      "default": "#E9DACB"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Photo",
      "info": "Optional. Shown instead of the main photo on phones, and only downloaded there. Useful when the wide photo has no crop that works upright — upload a squarer or portrait version of the same scene."
    },
    {
      "type": "select",
      "id": "image_order_mobile",
      "label": "Photo position",
      "info": "Where the photo sits once the section stacks on a phone.",
      "options": [
        { "value": "below", "label": "Under the text" },
        { "value": "above", "label": "Above the text" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "fit_mobile",
      "label": "Photo size",
      "info": "Whole photo shows the full frame with nothing cropped. Fixed height crops the sides to fill a set band — the taller the band, the more it crops.",
      "options": [
        { "value": "whole", "label": "Whole photo" },
        { "value": "crop", "label": "Fixed height" }
      ],
      "default": "whole"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Photo height",
      "info": "Used with Fixed height, and for banners using a packaged theme image, whose proportions the theme cannot read.",
      "default": 320
    },
    {
      "type": "select",
      "id": "image_focus_mobile",
      "label": "Photo focus",
      "info": "Which part of the photo to keep when it is cropped. Automatic uses the side opposite the text, which is where these photos put their subject.",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_leaf",
      "label": "Show leaf ornament",
      "default": false
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Heading (condensed caps)",
      "default": "Be a part of her"
    },
    {
      "type": "text",
      "id": "script",
      "label": "Script line",
      "default": "freedom story"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show short rule",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>At The Oasis, women who have survived trafficking are rebuilding their lives through healing, new skills, and the dignity of meaningful work. God is rewriting their stories. And their courage is being woven into something beautiful.</p><p>Now their hand-stitched journals and cards are making their way to you. When you purchase one, you don't just take home something beautiful—you carry her story forward.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Oasis story banner"
    }
  ]
}
{% endschema %}
