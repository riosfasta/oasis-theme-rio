{
  "sections": {
    "banner": {
      "type": "oasis-page-banner",
      "settings": {
        "fallback_asset": "oasis-banner-cards.jpg",
        "content_position": "left",
        "height": 365,
        "content_width": 600,
        "scrim_color": "#f1e4d4",
        "use_collection": false,
        "use_page": false,
        "show_ornament": true,
        "text": "<p>Hand-stitched cards for the moments that matter. Celebrate, encourage, and connect with a story of hope behind every stitch.</p>",
        "title": "Shop Cards"
      }
    },
    "promo": {
      "type": "oasis-promo-strip",
      "settings": {
        "text": "Choose any 5 hand-stitched cards for $20.",
        "background": "#a2846f",
        "text_color": "#ffffff",
        "height": 80
      }
    },
    "tabs": {
      "type": "oasis-category-tabs",
      "settings": {
        "menu": "card-categories",
        "aria_label": "Card categories",
        "padding_top": 40,
        "padding_bottom": 8
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
        "enable_filtering": false,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "padding_top": 0,
        "padding_bottom": 72
      }
    },
    "story": {
      "type": "oasis-story-banner",
      "settings": {
        "fallback_asset": "oasis-story-bigger-story.jpg",
        "content_position": "right",
        "kicker_style": "tracked",
        "text_align": "center",
        "height": 590,
        "content_width": 620,
        "scrim_color": "#fbf7f4",
        "show_leaf": true,
        "show_rule": true,
        "kicker": "A little card.",
        "script": "a bigger story.",
        "text": "<p>Each card is lovingly hand-stitched by a woman rebuilding her life after trafficking. Your purchase provides meaningful work and helps create a pathway toward hope and a new future.</p>",
        "button_label": "Learn more about The Oasis",
        "button_link": "/pages/about-us"
      }
    }
  },
  "order": [
    "banner",
    "promo",
    "tabs",
    "product-grid",
    "story"
  ]
}